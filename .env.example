# Copy this file to .env for local development. .env is gitignored —
# never commit real credentials, and never point a local .env at the
# production database.

# Local development mode. Production leaves this unset (or False), and then
# the app refuses to start without SECRET_KEY, DATABASE_URL,
# DJANGO_ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS. See docs/ENVIRONMENT.md.
DJANGO_DEBUG=True

# Leave DATABASE_URL unset to use a local SQLite file (db.sqlite3).
# DATABASE_URL=postgresql://user:password@localhost:5432/housemaster

GEMINI_API_KEY=

# Staff invite emails (accounts.Invite). Leave EMAIL_BACKEND unset in dev —
# invite emails will just print to the runserver console instead of sending.
# FRONTEND_URL should be the deployed Vercel URL in production.
FRONTEND_URL=http://localhost:5173
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
