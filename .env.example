# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real credentials.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
GEMINI_API_KEY=

# Staff invite emails (accounts.Invite). Leave EMAIL_BACKEND unset in dev —
# invite emails will just print to the runserver console instead of sending.
# FRONTEND_URL should be the deployed Vercel URL in production.
FRONTEND_URL=http://localhost:5173
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com
